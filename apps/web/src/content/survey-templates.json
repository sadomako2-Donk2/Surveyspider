    {
      "key": "academic",
      "group": "research",
      "name": "Academic questionnaire",
      "blurb": "A student study with screening and an attention check.",
      "title": "Study habits and wellbeing",
      "description": "A university research study about how students study and how they feel. Your answers are anonymous and you can stop at any time.",
      "minutes": 8,
      "reward": 1.6,
      "target": 200,
      "occupations": ["Student"],
      "questions": [
        {
          "type": "NUMBER",
          "text": "On a typical weekday, how many hours do you study?",
          "options": []
        },
        {
          "type": "SINGLE",
          "text": "Where do you study most often?",
          "options": ["At home", "Library", "Café", "Elsewhere on campus", "Other"]
        },
        {
          "type": "LIKERT",
          "text": "In the past two weeks, how often have you felt stressed?",
          "options": ["Never", "Rarely", "Sometimes", "Often", "Always"]
        },
        {
          "type": "LIKERT",
          "text": "I feel confident about my exams this term.",
          "options": [
            "Strongly disagree",
            "Disagree",
            "Somewhat disagree",
            "Neither agree nor disagree",
            "Somewhat agree",
            "Agree",
            "Strongly agree"
          ]
        },
        {
          "type": "RATING",
          "text": "How would you rate your overall wellbeing right now?",
          "options": [],
          "scale": {
            "min": 1,
            "max": 10,
            "minLabel": "Very poor",
            "maxLabel": "Excellent"
          }
        },
        {
          "type": "MULTI",
          "text": "Which tools do you use to plan your study time?",
          "options": ["Paper planner", "Calendar app", "To-do app", "None"]
        },
        {
          "type": "TEXT",
          "text": "Describe one habit that helps you study well.",
          "options": []
        }
      ]
    },
    {
      "key": "tna",
      "group": "train",
      "name": "Training needs analysis",
      "blurb": "Find the skill gaps to train for before you plan a programme.",
