        {
          "type": "LIKERT",
          "text": "How often does your manager discuss your development with you?",
          "options": ["Never", "Rarely", "Sometimes", "Often", "Always"]
        },
        {
          "type": "NUMBER",
          "text": "How many hours a month could you give to training?",
          "options": []
        },
        {
          "type": "TEXT",
          "text": "What is the biggest skill gap in your team right now?",
          "options": []
        }
      ]
    },
