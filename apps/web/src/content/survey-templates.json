  "templates": [
    {
      "key": "cx",
      "group": "research",
      "name": "Customer satisfaction",
      "blurb": "Measure satisfaction and find what to fix first.",
      "title": "Online shopping satisfaction",
      "description": "A short survey about your experience shopping online. There are no right or wrong answers.",
      "minutes": 5,
      "reward": 1,
      "target": 150,
      "occupations": [],
      "questions": [
        {
          "type": "SINGLE",
          "text": "How often do you shop online?",
          "options": ["Daily", "Weekly", "Monthly", "A few times a year", "Never"]
        },
        {
          "type": "LIKERT",
          "text": "Overall, how satisfied are you with online shopping?",
          "options": ["Very dissatisfied", "Dissatisfied", "Neutral", "Satisfied", "Very satisfied"]
        },
        {
          "type": "MULTI",
          "text": "Which problems have you had in the last 6 months?",
          "options": ["Late delivery", "Wrong item", "Difficult returns", "Hidden fees", "None of these"]
        },
        {
          "type": "RATING",
          "text": "How likely are you to recommend online shopping to a friend?",
          "options": [],
          "scale": {
            "min": 0,
            "max": 10,
            "minLabel": "Not at all likely",
            "maxLabel": "Extremely likely"
          }
        },
        {
          "type": "TEXT",
          "text": "What one change would make you shop online more?",
          "options": []
        }
      ]
    },
    {
