# Copy to .env and adjust. Never commit .env.
DATABASE_URL="postgresql://afri:afri@127.0.0.1:5432/afrimetrica_dev"
# Any existing database the test role can connect to. `npm run test:db` creates a fresh
# throwaway database next to it for each run and drops it afterwards; this one is never changed.
TEST_DATABASE_URL="postgresql://afri:afri@127.0.0.1:5432/afrimetrica_test"

# Optional: turns on the AI features (never commit a real key). Default limit is 40 AI requests per account per hour.
ANTHROPIC_API_KEY=
# AI_REQUESTS_PER_HOUR=40

# Google Search Console ownership code ("HTML tag" method). Not secret.
GOOGLE_SITE_VERIFICATION=
